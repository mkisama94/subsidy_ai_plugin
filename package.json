{
  "name": "subsidy-ai-mcp",
  "version": "0.13.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "tsx --test test/**/*.test.ts",
    "eval:skill": "node evaluation/skill/cli.mjs",
    "test:skill-eval": "node --test evaluation/skill/tests/*.test.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:application-assist": "tsc --noEmit -p tsconfig.application-assist.json",
    "test:application-assist": "tsx --test test/applicationAssist/*.test.ts",
    "application-assist": "tsx scripts/application-assist/cli.ts",
    "application-assist:simulate": "tsx scripts/application-assist/simulate.ts",
    "application-assist:import": "tsx scripts/application-assist/import-manifest.ts",
    "application-assist:ocr": "tsx scripts/application-assist/ocr.ts",
    "application-assist:import-api": "tsx scripts/application-assist/import-api.ts",
    "application-assist:snapshot-official": "tsx scripts/application-assist/snapshot-official.ts",
    "test:public-history-runtime": "node scripts/test-public-history-runtime.mjs",
    "comparison:preview": "tsx scripts/verify-comparison-ui.ts --preview-only",
    "comparison:verify-ui": "tsx scripts/verify-comparison-ui.ts",
    "documents:import": "tsx scripts/import-document-sources.mjs",
    "documents:admin": "node scripts/documents-admin.mjs",
    "mhlw:admin": "tsx scripts/mhlw-admin.ts",
    "mhlw:verify-live": "tsx scripts/verify-mhlw-live.ts",
    "mhlw:pdf:dev": "wrangler dev --config wrangler.mhlw-pdf.jsonc",
    "mhlw:pdf:build": "wrangler deploy --dry-run --config wrangler.mhlw-pdf.jsonc",
    "mhlw:config": "tsx scripts/mhlw-config.ts",
    "mhlw:verify-contract": "tsx scripts/verify-mhlw-contract.ts",
    "test:subsidy-rules": "node packages/subsidy-rules/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.0",
    "fflate": "^0.8.3",
    "linkedom": "0.18.12",
    "unpdf": "1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.135.0"
  }
}
