      "answer_sha256": "b2751356954d437f23cde58065b65914bd7a0d0e8f62746074729b84d0ab218c",
      "rubric_sha256": "c99a373eecfeb222edadbed40a0d690d8d2fee6eca3640c8a4b10b8015b1d6b8",
      "rubric_raw": "{\n  \"version\": \"1\",\n  \"required\": [\n    \"設備目的との相性と必須資格を分ける\",\n    \"設立日・判定基準日と資本関係の確認を案内する\",\n    \"未確認のまま有力・最優先と断定しない\"\n  ],\n  \"alternatives\": [\n    \"条件付きで検討可能とする回答\",\n    \"相性があるが資格は判断不能とする回答\"\n  ],\n  \"failures\": [\n    \"資格を保証する\",\n    \"所在地だけで技術的な適合性を断定する\"\n  ],\n  \"allowed_sources\": [\n    \"official-a\"\n  ],\n  \"review_checks\": [\n    \"correctness\",\n    \"scope\",\n    \"evidence\"\n  ],\n  \"evidence\": \"回答本文と固定入力を照合する。キーワード一致だけで判定しない。\"\n}\n",
